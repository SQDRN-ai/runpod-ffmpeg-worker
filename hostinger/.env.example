# Generate a long, random value. This is used by n8n when calling the internal API.
WORKER_API_TOKEN=replace-with-a-long-random-secret

# Cloudflare R2 (never commit the real values)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=birthday-media
R2_PUBLIC_BASE_URL=https://<your-public-r2-domain>

# Name of the existing Docker network to which the n8n container is attached.
N8N_DOCKER_NETWORK=n8n_default

# Operational settings
JOB_TTL_SECONDS=604800
HEAVY_LOCK_TTL_SECONDS=43200
RENDER_CPU_LIMIT=1.25
RENDER_MEMORY_LIMIT=2G
VOICE_CPU_LIMIT=1.0
VOICE_MEMORY_LIMIT=4G
